{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yu37330/Physical_ai/schemas/checkpoint_manifest.schema.json",
  "title": "PARC2026 Checkpoint Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "model_id",
    "generated_at",
    "source",
    "model_root",
    "files",
    "summary",
    "required_pattern_matches",
    "missing_required_patterns",
    "symlinks",
    "budgets",
    "checks",
    "status"
  ],
  "properties": {
    "manifest_version": {"type": "string"},
    "model_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["repo_id", "requested_revision"],
      "additionalProperties": true
    },
    "model_root": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "role",
          "training_only",
          "include_in_submission"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {
            "type": "string",
            "enum": [
              "model_weights",
              "action_head",
              "proprio_projector",
              "dataset_statistics",
              "tokenizer",
              "configuration",
              "adapter",
              "training_state",
              "support"
            ]
          },
          "training_only": {"type": "boolean"},
          "include_in_submission": {"type": "boolean"}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "file_count",
        "total_bytes",
        "submission_file_count",
        "submission_bytes",
        "model_shard_count",
        "training_state_file_count"
      ],
      "additionalProperties": false,
      "properties": {
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "submission_file_count": {"type": "integer", "minimum": 0},
        "submission_bytes": {"type": "integer", "minimum": 0},
        "model_shard_count": {"type": "integer", "minimum": 0},
        "training_state_file_count": {"type": "integer", "minimum": 0}
      }
    },
    "required_pattern_matches": {"type": "object"},
    "missing_required_patterns": {"type": "array", "items": {"type": "string"}},
    "symlinks": {"type": "array", "items": {"type": "string"}},
    "budgets": {"type": "object"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "status": {"type": "string", "enum": ["pass", "fail"]}
  }
}
